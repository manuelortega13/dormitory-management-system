# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=dormitory_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:4200

GROQ_API_KEY=

# VAPID Keys for Web Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Semaphore SMS Configuration
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=PAC_DMS

# Face Verification (parent approval of leave requests / gatepasses)
# Max descriptor distance still treated as the same person. Lower = stricter.
# Measured on this model:
#   0.6  - the old value; accepted a DIFFERENT person 8-13% of the time.
#   0.16-0.44 - same person across separate enrolment sessions.
#   0.70+     - enrolled photo vs 22 strangers (n=154, never lower).
#   0.55      - floor on the hardest impostor set (lookalikes, matched lighting).
# 0.50 clears the genuine ceiling, stays under the impostor floor, and measured
# 0% false accepts everywhere tested.
# Tune from real traffic: SELECT outcome, MIN(distance), AVG(distance), MAX(distance)
#   FROM face_verification_attempts GROUP BY outcome;
# Genuine parents being rejected will show up as 'rejected' rows with distances
# just above this value — that is the signal to loosen it, not guesswork.
FACE_MATCH_THRESHOLD=0.50

# Quality gates — input the model cannot judge reliably is refused, not compared.
FACE_MIN_DETECTION_SCORE=0.5
FACE_MIN_FACE_WIDTH_PX=80
FACE_MIN_FACE_WIDTH_RATIO=0.10
FACE_MIN_SHARPNESS=20

# Attempt limits. Face matching is probabilistic, so unlimited retries would let
# an attacker keep trying photos until one slips under the threshold.
FACE_MAX_ATTEMPTS_PER_TARGET=5
FACE_MAX_ATTEMPTS_PER_USER=15
FACE_ATTEMPT_WINDOW_MINUTES=15
